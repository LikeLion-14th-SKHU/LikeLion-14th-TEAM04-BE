# 이 파일을 .env로 복사해서 실제 값을 채운다. .env는 gitignore 대상.
#   cp .env.example .env

# --- MySQL ---
DB_ROOT_PASSWORD=
DB_NAME=memory_atelier
DB_USERNAME=memory_atelier
DB_PASSWORD=

# --- MinIO (S3_ACCESS_KEY/SECRET_KEY로 그대로 재사용됨) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_BUCKET=memory-atelier

# --- 앱 공통 ---
# 로컬에서 nginx로 접근 테스트할 땐 http://localhost, 실제 배포 시 프론트 도메인으로 교체
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=

# --- 소셜 로그인 ---
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://api.도메인/api/v1/auth/kakao/callback
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=https://api.도메인/api/v1/auth/google/callback
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_REDIRECT_URI=https://api.도메인/api/v1/auth/naver/callback
NAVER_CLIENT_SECRET=

# --- AI 파이프라인 서버 ---
AI_BASE_URL=http://localhost:8000
